# --------------------------------------------------------------------------
# (2026-08-14) Provenance repair: exclude every remaining GENERATED or
# heavyweight tree so the checkpoint commit records authored work, not build
# output. Sizes per the 2026-08-14 forensic audit: archives 90 GiB, runtime
# 78 GiB, Tauri targets 64 GiB, dist 8.8 GiB, plus model weights and Flutter
# build output. Already-tracked files under these paths stay tracked until
# removed with git rm --cached; these rules stop NEW generated content.
# --------------------------------------------------------------------------
archives/
archive/
runtime/
dist/
*.gguf
*.safetensors
*.onnx
*.iso
*.7z
*.tar
*.tar.gz
models/
models-active/
hf-cache/
.pytest_cache/
.dart_tool/
.gradle/
node_modules/
engel_flutter_main/build/
engel_main/src-tauri/target/
engel_main/node_modules/
engel_main/dist/
*.pyc
# Live files rewritten mid-run by services - unindexable while hot (git add died
# on a short read of one during the 2026-08-14 checkpoint) and worthless as history.
**/LATEST.json
reports/engel_lifted_intent/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Local secrets (Discord bot token etc.) — NEVER commit
.cursor/benny/slack.local.yaml
.env
.env.local
.env.*.local
run/secrets/*.env
!run/secrets/*.env.example

# Playwright browser-profile caches generated every session by the
# browser-AI bridge. Already-tracked files in this tree stay tracked
# until manually removed; this rule only prevents NEW cache files from
# auto-entering the index.
browser_profile/*/Default/Cache/
browser_profile/*/Default/Code Cache/
browser_profile/*/Default/GPUCache/
browser_profile/*/Default/IndexedDB/
browser_profile/*/Default/Service Worker/
browser_profile/*/Default/Session Storage/
browser_profile/*/Default/Local Storage/
browser_profile/*/ShaderCache/
browser_profile/*/GrShaderCache/

# Codex/local usage state
.codex/usage/

# Generated backups and product test workspaces
backups/
products/

# Local evacuation archives from C:/Temp/AppData cleanup sweeps.
# Keep these on D: if needed, but do not track personal/temp dumps or secrets.
archive/c_drive_project_evacuated_*/
archive/os_temp_evacuated_*/

